{
  "name": "bareeq-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Bareeq API — creators, brands and requests (Express + PostgreSQL)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "node --env-file-if-exists=.env --test \"test/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.6",
    "express": "4.22.3",
    "express-rate-limit": "7.5.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.4.0",
    "pg": "8.23.1",
    "zod": "3.25.76"
  }
}
