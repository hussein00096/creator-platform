# Copy to .env and fill in.

PORT=4000

# PostgreSQL connection: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/bareeq

# Long random string used to sign login tokens (keep secret; changing it logs everyone out).
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=30d

# The site's address(es), comma separated.
CORS_ORIGIN=http://localhost:3000

# Where uploaded photos are stored (relative to this folder).
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# Admin account created by `npm run db:seed` (phone or e-mail + password).
ADMIN_NAME=Admin
ADMIN_PHONE=
ADMIN_EMAIL=
ADMIN_PASSWORD=
